# Optional external intelligence (Tavily). Leave blank to keep SNIFF offline.
TAVILY_API_KEY=

# Optional persistence (Supabase). Leave blank to keep local file outputs only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never expose to frontend / browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional adaptive LLM locator (OpenRouter). Off unless set; never required.
OPENROUTER_API_KEY=
# Set to "off" to force-disable even when a key is present.
SNIFF_LLM=
